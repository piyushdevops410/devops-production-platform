pipeline {

    agent any

    environment {
        APP_NAME = 'devops-production-app'
        AWS_REGION = 'us-east-1'
        ECR_REPOSITORY = 'devops-production-app'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Application Test') {
            steps {
                dir('app') {
                    sh 'npm ci'
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('app') {
                    sh '''
                        docker build \
                          -t ${APP_NAME}:${BUILD_NUMBER} .
                    '''
                }
            }
        }

        stage('Docker Test') {
            steps {
                sh '''
                    docker run -d \
                      --name ${APP_NAME}-test-${BUILD_NUMBER} \
                      -p 3100:3000 \
                      ${APP_NAME}:${BUILD_NUMBER}

                    sleep 5

                    curl -f http://localhost:3100/health

                    docker rm -f ${APP_NAME}-test-${BUILD_NUMBER}
                '''
            }
        }

        stage('ECR Login') {
            steps {
                sh '''
                    aws ecr get-login-password \
                      --region ${AWS_REGION} | \
                    docker login \
                      --username AWS \
                      --password-stdin \
                      $(aws sts get-caller-identity --query Account --output text).dkr.ecr.${AWS_REGION}.amazonaws.com
                '''
            }
        }

        stage('Push to ECR') {
            steps {
                sh '''
                    ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)

                    ECR_URI=${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}

                    docker tag \
                      ${APP_NAME}:${BUILD_NUMBER} \
                      ${ECR_URI}:${BUILD_NUMBER}

                    docker tag \
                      ${APP_NAME}:${BUILD_NUMBER} \
                      ${ECR_URI}:latest

                    docker push ${ECR_URI}:${BUILD_NUMBER}

                    docker push ${ECR_URI}:latest
                '''
            }
        }
    }

    post {
        success {
            echo 'DevOps Production Platform CI/CD completed successfully!'
        }

        failure {
            echo 'CI/CD pipeline failed. Check the failed stage.'
        }
    }
}
